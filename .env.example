TWITCH_CLIENT_ID=your_client_id_here
TWITCH_CLIENT_SECRET=your_client_secret_here
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Числовой id канала (-100…), НЕ @username — переживает переименование канала.
# Получить: добавить бота админом в канал, затем getChat. Пусто = автопубликация выключена.
TELEGRAM_CHANNEL_ID=
# Рубильник постинга: false = не постить (донастройка), true = постить
PUBLISH_ENABLED=false
# Приватный chat_id владельца для алертов надёжности
ALERT_CHAT_ID=
# ALERT_BOT_TOKEN=  # опц.: отдельный бот для алертов (иначе TELEGRAM_BOT_TOKEN)
# Тихие часы МСК (не беспокоить ночью несрочными постами). START==END = выкл.
QUIET_HOURS_START=23
QUIET_HOURS_END=9
