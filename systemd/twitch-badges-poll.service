[Unit]
# OnFailure намеренно НЕТ. Один неудачный прогон — не событие для владельца:
# опрос ходит раз в 2 минуты, и любой таймаут источника будил бы по кругу
# «упал» / «восстановился». Настоящий сигнал уровневый — «данные не
# обновляются», его даёт watchdog по возрасту snapshot.
Description=Poll StreamDatabase for changes, trigger refresh immediately
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=archie
WorkingDirectory=/home/archie/projects/twitch-badges
ExecStart=/home/archie/projects/twitch-badges/venv/bin/python /home/archie/projects/twitch-badges/poll_changes.py
# Опрос — три коротких запроса; если завис дольше минуты, значит SD не отвечает,
# и ждать смысла нет: следующий тик через 2 минуты попробует заново.
# Таймер тикает раз в 2 минуты; параллельный запуск systemd не сделает, поэтому
# предел близок к периоду. 60 с было мало: один медленный ответ SD дал ложный
# алерт «юнит упал», хотя следующий тик отработал штатно.
# 150 с: во время деплоя StreamDatabase отвечает медленно, и прежних 100 не
# хватало — 19.09.2026 прогон убило по таймауту, что дало ложную тревогу.
# Таймер тикает раз в 2 минуты; параллельный запуск systemd всё равно не сделает.
TimeoutStartSec=150
MemoryMax=128M
