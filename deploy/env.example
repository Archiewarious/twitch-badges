# /etc/twitch-badges/env — владелец root, группа twitchbadges, права 0640.
# Формат KEY=VALUE, без export и подстановок: файл читают systemd и watchdog.sh,
# но НЕ исполняет bash.

# Основной бот (@InfoTwitchBot) и канал
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
# Постинг включается отдельно: сначала всё проверить с false
PUBLISH_ENABLED=false

# Служебный приватный канал для карточек и бэкапов. Можно не задавать: бот сам
# запомнит канал, в который его добавит админом владелец.
TELEGRAM_STORAGE_CHAT_ID=

# Алерты: личный чат владельца и (желательно) отдельный бот для алертов
ALERT_CHAT_ID=
ALERT_BOT_TOKEN=
# Внешний dead-man (healthchecks.io), пингуется раз в 15 минут
DEADMAN_URL=

# Twitch Helix (dev.twitch.tv → приложение)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Тихие часы по МСК; одинаковые значения — выключены
QUIET_HOURS_START=0
QUIET_HOURS_END=0

# Только для тестового стенда:
# TELEGRAM_API_BASE=
# SD_BASE_URL=
# TB_FAULTS=
