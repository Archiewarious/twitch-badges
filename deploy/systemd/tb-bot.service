[Unit]
Description=@InfoTwitchBot: публикация в канал, inline, алерты
Documentation=file:///opt/twitch-badges/current/README.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
User=twitchbadges
Group=twitchbadges
EnvironmentFile=/etc/twitch-badges/env
Environment=DATA_DIR=/var/lib/twitch-badges PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=/opt/twitch-badges/current
ExecStart=/opt/twitch-badges/current/venv/bin/python -m twitch_badges bot
Restart=always
RestartSec=10
# Пинг идёт из цикла событий раз в минуту: завис цикл — перезапуск через 3 мин
WatchdogSec=180
TimeoutStartSec=120
TimeoutStopSec=90
StateDirectory=twitch-badges
StateDirectoryMode=0750
MemoryMax=400M
# Изоляция: пользователь без sudo и docker, система только для чтения,
# писать можно лишь в свой StateDirectory (E1, E2).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
PrivateUsers=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027

[Install]
WantedBy=multi-user.target
