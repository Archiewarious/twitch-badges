[Unit]
Description=@InfoTwitchBot: сбор данных StreamDatabase + Twitch (один прогон)
Documentation=file:///opt/twitch-badges/current/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=twitchbadges
Group=twitchbadges
EnvironmentFile=/etc/twitch-badges/env
Environment=DATA_DIR=/var/lib/twitch-badges PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=/opt/twitch-badges/current
# Внутренний дедлайн прогона — 8 мин; systemd страхует на 10.
ExecStart=/opt/twitch-badges/current/venv/bin/python -m twitch_badges collect
TimeoutStartSec=600
StateDirectory=twitch-badges
StateDirectoryMode=0750
MemoryMax=600M
Nice=5
# Изоляция: пользователь без sudo и docker, система только для чтения,
# писать можно лишь в свой StateDirectory (E1, E2).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
PrivateUsers=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027
